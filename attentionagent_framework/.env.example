# Your API keys. Fill in the platforms you use; leave the rest blank.

# X
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Instagram
IG_USER_ID=
IG_ACCESS_TOKEN=

# Facebook
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Threads
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# TikTok
TIKTOK_ACCESS_TOKEN=

# Meta Ads (for meta-ads/skills/promote-winners)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_

# Slack notifications (optional — leave blank to disable)
# Create an Incoming Webhook at https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# CDN / S3 (required for Instagram, Facebook, Threads — they need a public media URL)
# Any public S3 bucket works. Set S3_PUBLIC_BASE_URL to your bucket or CloudFront URL.
CDN_PROVIDER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
