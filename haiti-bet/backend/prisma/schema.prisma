generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum MatchStatus {
  SCHEDULED
  LIVE
  HALFTIME
  FINISHED
  POSTPONED
  CANCELLED
}

enum MarketCategory {
  MATCH_RESULT
  GOALS
  HANDICAP
  PLAYER
  LIVE
  SPECIAL
}

enum MarketStatus {
  OPEN
  SUSPENDED
  CLOSED
  SETTLED
  CANCELLED
}

enum BetStatus {
  PENDING
  WON
  LOST
  CANCELLED
  VOID
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_WIN
  BET_REFUND
  BONUS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id           String     @id @default(cuid())
  phone        String     @unique
  email        String?    @unique
  name         String
  passwordHash String?
  status       UserStatus @default(PENDING_VERIFICATION)
  balance      Decimal    @default(0) @db.Decimal(12, 2)
  isAdmin      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  bets          Bet[]
  transactions  Transaction[]
  notifications Notification[]
  otpTokens     OtpToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Match {
  id          String      @id @default(cuid())
  externalId  String?     @unique
  homeTeam    String
  awayTeam    String
  competition String
  venue       String?
  scheduledAt DateTime
  status      MatchStatus @default(SCHEDULED)
  homeScore   Int         @default(0)
  awayScore   Int         @default(0)
  minute      Int?
  period      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  markets Market[]
  events  MatchEvent[]

  @@map("matches")
}

model MatchEvent {
  id          String   @id @default(cuid())
  matchId     String
  type        String
  minute      Int
  team        String
  player      String?
  description String?
  createdAt   DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id])

  @@map("match_events")
}

model Market {
  id               String         @id @default(cuid())
  matchId          String
  name             String
  category         MarketCategory
  status           MarketStatus   @default(OPEN)
  isLive           Boolean        @default(false)
  suspendedAt      DateTime?
  suspendReason    String?
  settledAt        DateTime?
  settlementResult String?
  totalExposure    Decimal        @default(0) @db.Decimal(12, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  match    Match          @relation(fields: [matchId], references: [id])
  outcomes MarketOutcome[]
  bets     BetSelection[]

  @@map("markets")
}

model MarketOutcome {
  id       String @id @default(cuid())
  marketId String
  name     String
  code     String

  market       Market       @relation(fields: [marketId], references: [id])
  odds         Odds[]
  betSelections BetSelection[]

  @@unique([marketId, code])
  @@map("market_outcomes")
}

model Odds {
  id        String   @id @default(cuid())
  outcomeId String
  value     Decimal  @db.Decimal(8, 4)
  margin    Decimal  @db.Decimal(5, 4)
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  outcome MarketOutcome @relation(fields: [outcomeId], references: [id])

  @@map("odds")
}

model Bet {
  id             String    @id @default(cuid())
  userId         String
  totalStake     Decimal   @db.Decimal(12, 2)
  potentialWin   Decimal   @db.Decimal(12, 2)
  status         BetStatus @default(PENDING)
  idempotencyKey String    @unique
  placedAt       DateTime  @default(now())
  settledAt      DateTime?

  user       User           @relation(fields: [userId], references: [id])
  selections BetSelection[]

  @@map("bets")
}

model BetSelection {
  id          String  @id @default(cuid())
  betId       String
  marketId    String
  outcomeId   String
  oddsValue   Decimal @db.Decimal(8, 4)
  oddsVersion Int
  result      String?

  bet     Bet           @relation(fields: [betId], references: [id])
  market  Market        @relation(fields: [marketId], references: [id])
  outcome MarketOutcome @relation(fields: [outcomeId], references: [id])

  @@map("bet_selections")
}

model Transaction {
  id             String            @id @default(cuid())
  userId         String
  type           TransactionType
  amount         Decimal           @db.Decimal(12, 2)
  status         TransactionStatus @default(PENDING)
  moncashOrderId String?
  moncashToken   String?
  idempotencyKey String            @unique
  reference      String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user     User              @relation(fields: [userId], references: [id])
  callback MoncashCallback?

  @@map("transactions")
}

model MoncashCallback {
  id            String   @id @default(cuid())
  transactionId String   @unique
  orderId       String
  rawPayload    Json
  processedAt   DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@map("moncash_callbacks")
}

model OtpToken {
  id        String    @id @default(cuid())
  userId    String?
  phone     String
  code      String
  purpose   String    @default("login")
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("otp_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}
