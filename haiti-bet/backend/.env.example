# App
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://haiti_bet:password@localhost:5432/haiti_bet

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_me_in_production_min_32_chars
JWT_EXPIRES_IN=7d
OTP_EXPIRES_MINUTES=5

# MonCash
MONCASH_CLIENT_ID=your_moncash_client_id
MONCASH_CLIENT_SECRET=your_moncash_client_secret
MONCASH_BASE_URL=https://sandbox.moncashbutton.digicelgroup.com
MONCASH_REDIRECT_URL=http://localhost:3000/wallet?payment=complete

# Admin
ADMIN_SECRET=admin_bootstrap_secret

# SMS (Vonage/Twilio)
SMS_PROVIDER=vonage
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
SMS_FROM=HAITIBET

# Odds Engine (internal)
BOOKMAKER_MARGIN=0.05
SUSPENSION_TIMEOUT_MS=30000
MAX_BET_STAKE=50000
MIN_BET_STAKE=25
MAX_EXPOSURE_PER_MARKET=500000

# External Odds API — the-odds-api.com
# Get your key at: https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here
ODDS_CACHE_TTL_SECONDS=60
ODDS_STALE_TTL_SECONDS=600
ODDS_API_TIMEOUT_MS=8000
ODDS_SYNC_INTERVAL_MS=60000
ODDS_DRIFT_THRESHOLD_PCT=12

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
